# Maintainer: Rodrigo Martinez <elgalacticoyt@gmail.com>
pkgname=anonify
pkgver=1.0.0
pkgrel=1
pkgdesc="Temporary, reversible network privacy hardening for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/grubberdubber/anonify"
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'nftables' 'iproute2' 'procps-ng')
makedepends=('cargo' 'rust')
optdepends=(
  'tor: tor and dns modules'
  'wireguard-tools: vpn module'
  'networkmanager: runtime MAC/IPv6 changes through nmcli'
  'bubblewrap: launch --isolate'
  'curl: Tor exit-IP verification in check'
  'obfs4proxy: pluggable transports for --tor-bridges'
)
options=(!lto)
source=("$pkgname-$pkgver.tar.gz::https://github.com/grubberdubber/anonify/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b1abc53bb185b93a01376b2cd392d6aae94215839285bc5e425cc81e599a4426')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked --bins
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  # Tests that touch nftables skip themselves unless they can prove they run
  # inside an isolated network namespace, so this is safe in a build chroot.
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/anonify "$pkgdir/usr/bin/anonify"
  install -Dm755 target/release/anonify-browser "$pkgdir/usr/bin/anonify-browser"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
  install -Dm644 docs/install.md "$pkgdir/usr/share/doc/$pkgname/install.md"
  install -Dm644 docs/platforms.md "$pkgdir/usr/share/doc/$pkgname/platforms.md"
  install -Dm644 docs/stability.md "$pkgdir/usr/share/doc/$pkgname/stability.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
